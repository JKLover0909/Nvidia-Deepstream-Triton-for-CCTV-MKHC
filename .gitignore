# Ignore Python virtual environments

env/
venv/
.venv/

# Ignore model folders

Models/

# Ignore PyTorch model weights

*.pt

# (Optional but recommended) Ignore other large ML artifacts

*.onnx
*.engine

# Python cache

**pycache**/
*.pyc
*.pyo

# Jupyter checkpoints

.ipynb_checkpoints/

# OS files

.DS_Store

# NVIDIA DeepStream SDK: install it from NVIDIA, do not commit it.
# Only the project's own label file under samples/models/Meiko_CCTV/ is tracked.
/deepstream/deepstream-8.0/*
!/deepstream/deepstream-8.0/samples/
/deepstream/deepstream-8.0/samples/*
!/deepstream/deepstream-8.0/samples/models/
/deepstream/deepstream-8.0/samples/models/*
!/deepstream/deepstream-8.0/samples/models/Meiko_CCTV/

# Model weights
*.pt
*.engine
*.onnx

# Python env
env/
venv/
.venv/